# ShareNep Environment Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Session Authentication (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min32chars

# SQLite Database Storage Path
DATABASE_PATH=./data/sharenep.db

# ==============================================================================
# AUTHORIZED NEPSE MARKET DATA PROVIDER CONFIGURATION
# ==============================================================================
# NEPSE_DATA_MODE options:
#   - 'sourcecode' : Connects to Source Code Pvt. Ltd. (NEPSE Licensed Market Data Provider - MDP)
#   - 'mock_mdp'   : Realistic wire-protocol simulation of Source Code MDP for testing & verification
#   - 'demo'       : Offline demonstration mode with clearly labeled synthetic quotes and summaries
NEPSE_DATA_MODE=demo

# --- Source Code Pvt. Ltd. (MDP) Commercial Credentials ---
# Official exchange-licensed data vendor in Nepal (https://sourcecode.com.np)
# Note: Requires a formal commercial redistribution agreement with Source Code / NEPSE.
# Personal subscriptions or scraping do not confer public redistribution rights.
SOURCECODE_BASE_URL=https://uat.sourcecode.com.np
SOURCECODE_API_KEY=your_sourcecode_mdp_api_key_here
SOURCECODE_API_SECRET=your_sourcecode_mdp_api_secret_here
SOURCECODE_ACCESS_ID=your_sourcecode_access_id_here
SOURCECODE_API_VERSION=1.0

# Subscription Feed Tier: 'LIVE' (real-time), 'DELAYED_15MIN' (15-minute delay), or 'END_OF_DAY'
SOURCECODE_FEED_TYPE=DELAYED_15MIN

# Client-Side / Cache Tuning
# Requests within TTL are served from server memory to prevent exceeding provider rate limits
NEPSE_CACHE_TTL_SECONDS=60
SOURCECODE_TIMEOUT_MS=8000
SOURCECODE_MAX_RETRIES=2

